# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database: SQLite (tmp/db.sqlite3) when unset. Production and staging use
# MySQL; run the server with TZ=UTC so timestamps stay UTC.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_DATABASE=

# Session: cookie for development; database in production, so signing out
# ends the session on the server too (sessions table).
SESSION_DRIVER=cookie
LIMITER_STORE=database
MAIL_MAILER=smtp
MAIL_FROM_NAME=mlmsoft
MAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
# Comma-separated inboxes that receive new leads
SALES_NOTIFICATION_EMAILS=sales@example.com

# Sales WhatsApp in international format, e.g. 6281234567890. Leave empty to
# fall back to the demo form.
WHATSAPP_MARKETING_NUMBER=
WHATSAPP_MARKETING_ENABLED=true

# First-party marketing tracking (docs/marketing-attribution.md)
# MARKETING_TRACKING_ENABLED=true
# MARKETING_ANONYMOUS_RETENTION_DAYS=365
# MARKETING_REFERENCE_EXPIRY_DAYS=30

# Public sign-up of back-office accounts. Off in production by default;
# create staff accounts with `node ace users:create` instead.
# PUBLIC_SIGNUP_ENABLED=false

# How the back office shows dates (IANA name). Timestamps stay UTC.
# BUSINESS_TIMEZONE=Asia/Jakarta

# Search engines. Leave unset in production; set to false on staging so
# nothing there is indexed (robots.txt disallows all, every page noindex).
# SEARCH_INDEXING_ENABLED=false

# First admin account on hosts without a shell (Hostinger shared hosting):
# created by `node ace users:bootstrap` during `npm run build:hostinger`.
# Remove the password once the account exists.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
