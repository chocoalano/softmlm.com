# Always install devDependencies, also when NODE_ENV=production or with
# --omit=dev. Hostinger installs with production settings before running the
# build command, and `node ace build` needs the build tools that live in
# devDependencies (@poppinss/ts-exec, @adonisjs/tsconfig, @vitejs/plugin-vue,
# TypeScript, Vite). The built app in build/ does not load them at runtime.
include=dev
