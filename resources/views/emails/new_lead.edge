@component('emails/layout', { title: headline })
  <h1 style="margin:0 0 8px;font-size:20px;line-height:1.3;">
    {{ headline }}
    {{ company }}
  </h1>
  <p style="margin:0 0 20px;color:#676b74;">Submitted from {{ source }}.</p>

  <table
    role="presentation"
    width="100%"
    cellpadding="0"
    cellspacing="0"
    style="font-size:14px;border-collapse:collapse;"
  >
    @each(row in rows)
      <tr>
        <td style="padding:8px 0;border-top:1px solid #eef0f4;color:#676b74;width:40%;">
          {{ row[0] }}
        </td>
        <td style="padding:8px 0;border-top:1px solid #eef0f4;">{{ row[1] }}</td>
      </tr>
    @end
    @each(row in acquisition)
      <tr>
        <td style="padding:8px 0;border-top:1px solid #eef0f4;color:#676b74;">{{ row[0] }}</td>
        <td style="padding:8px 0;border-top:1px solid #eef0f4;">{{ row[1] }}</td>
      </tr>
    @end
    @each(row in utm)
      <tr>
        <td style="padding:8px 0;border-top:1px solid #eef0f4;color:#676b74;">
          UTM
          {{ row[0].toLowerCase() }}
        </td>
        <td style="padding:8px 0;border-top:1px solid #eef0f4;">{{ row[1] }}</td>
      </tr>
    @end
  </table>

  <p style="margin:28px 0 0;">
    <a
      href="{{ adminUrl }}"
      style="display:inline-block;padding:12px 20px;border-radius:10px;background:#005dfb;color:#ffffff;text-decoration:none;font-weight:600;"
    >
      Open the lead
    </a>
  </p>
@end
